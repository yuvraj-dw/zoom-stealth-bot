# Zoom Meeting & Webinar Attendee Credentials
ZOOM_MEETING_ID=1234567890
ZOOM_PASSCODE=123456
ATTENDEE_NAME="Your Name"
ATTENDEE_EMAIL=you@example.com

# Optional Webinar Direct Registration Token (bypasses registration & CAPTCHAs)
ZOOM_WEBINAR_TOKEN=

# Google Gemini API Key and Model (for meeting Q&A and Chat auto-summarization)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Duration & Monitoring Settings
MAX_DURATION_MINUTES=180
HEARTBEAT_INTERVAL_MINUTES=30

# Telegram Notifications & Remote Control
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=123456789

# Storage
SCREENSHOTS_DIR=./screenshots
